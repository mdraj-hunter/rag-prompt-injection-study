# --- LLM Provider Selection ---
LLM_PROVIDER=gemini

# --- Gemini (primary, free tier) ---
GEMINI_API_KEY=AIzaSyDw1L_VpsSgMjuYhOdOXecu16JRbHzzy6o
# Put whatever current Flash-tier model your Google AI Studio account has access to.
# As of writing, this is typically something like "gemini-1.5-flash" or "gemini-2.0-flash".
# Check https://aistudio.google.com/ for the exact model string available to your account.
GEMINI_MODEL= gemini-3.8-flash

# --- OpenAI (optional, only used if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Embeddings (local, CPU) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Experiment controls ---
MAX_CASES=10
REQUEST_DELAY_SECONDS=1.0
MAX_RETRIES=5
CACHE_DIR=results/cache